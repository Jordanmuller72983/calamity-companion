{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node --use-system-ca node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/index.mjs --log-level=warning",
    "deploy": "npm run build:api && vercel deploy --prod"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@upstash/redis": "^1.39.0",
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "i18next": "^26.4.6",
    "maplibre-gl": "^6.14.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.18",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vercel": "^64.3.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
